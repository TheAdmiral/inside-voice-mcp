{
  "name": "inside-voice-mcp",
  "version": "2.0.0",
  "description": "whisper.cpp MCP server for local speech-to-text transcription",
  "main": "src/index.js",
  "bin": {
    "inside-voice-mcp": "src/cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index.js --http",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:python": "uv run --no-project --python 3.13 --with numpy python test/test_diarize.py",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint src test scripts --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "setup:diarization": "node src/cli.js setup-diarization",
    "setup:token": "node src/cli.js setup-token",
    "models": "node src/cli.js models",
    "build:mcpb": "node scripts/build-mcpb.js"
  },
  "engines": {
    "node": ">=24.2"
  },
  "keywords": [
    "mcp",
    "whisper",
    "speech-to-text",
    "transcription"
  ],
  "author": "inside-voice-mcp",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "prettier": "^3.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
