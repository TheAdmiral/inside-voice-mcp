{
  "name": "whisper-mcp-server",
  "version": "1.0.3",
  "description": "whisper.cpp MCP server for local speech-to-text transcription",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "lint": "oxlint src test",
    "lint:fix": "oxlint src test --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "setup:models": "node scripts/setup-models.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "engines": {
    "node": ">=24.2"
  },
  "keywords": [
    "mcp",
    "whisper",
    "speech-to-text",
    "transcription"
  ],
  "author": "whisper-mcp-server",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "prettier": "^3.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
